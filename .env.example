EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
# Maps SDK for Android only; restrict to the app's package name + SHA-1 fingerprints
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Maps Static API only (profile travel map); cannot be app-restricted, so API-restrict + quota-cap it
EXPO_PUBLIC_GOOGLE_STATIC_MAPS_API_KEY=your-google-static-maps-api-key
